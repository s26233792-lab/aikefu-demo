# ===== 小红书千帆客服 Agent 配置 =====

# LLM 模式：llm=真实 DeepSeek 推理；rules=确定性规则降级（无需 Key）
XHS_LLM_MODE=llm

# DeepSeek（OpenAI 兼容接口）
XHS_LLM_BASE_URL=https://api.deepseek.com
XHS_LLM_MODEL=deepseek-chat

# 你的 DeepSeek API Key（必填，用于 llm 模式；不要提交到 git）
DEEPSEEK_API_KEY=

# 决策 API 鉴权 Key（可选；留空则不鉴权）
XHS_API_KEY=

# 业务标识
XHS_TENANT_ID=demo
XHS_STORE_ID=STORE-001

# 存储路径（默认见 config.py）
# XHS_DB_PATH=
# XHS_DATA_DIR=
# XHS_POLICY_PATH=

# 千帆浏览器 Worker
# XHS_DECISION_URL=http://127.0.0.1:18081
# XHS_QIANFAN_PROFILE=          # 留空时自动使用当前系统的用户数据目录
# XHS_QIANFAN_APP_PATH=         # Mac 示例：/Applications/千帆客服工作台.app
# XHS_QIANFAN_APP_NAME=千帆客服工作台
# XHS_QIANFAN_CDP_PORT=9222
# XHS_QIANFAN_STORE_NAME=       # 真实店铺名；用于过滤客服自己发出的消息
