# ===== 小红书千帆客服 Agent 配置 =====

# LLM 模式：llm=真实 DeepSeek 推理；rules=确定性规则降级（无需 Key）
XHS_LLM_MODE=llm

# DeepSeek（OpenAI 兼容接口）
XHS_LLM_BASE_URL=https://api.deepseek.com
XHS_LLM_MODEL=deepseek-v4-flash

# 你的 DeepSeek API Key（必填，用于 llm 模式；不要提交到 git）
DEEPSEEK_API_KEY=
# 也可使用任意 OpenAI 兼容服务的 Key；设置后优先于 DEEPSEEK_API_KEY
XHS_LLM_API_KEY=

# 决策 API 鉴权 Key（可选；留空则不鉴权）
XHS_API_KEY=

# 业务标识
XHS_TENANT_ID=demo
XHS_STORE_ID=STORE-001

# 存储路径（默认见 config.py）
# XHS_DB_PATH=
# XHS_DATA_DIR=
# XHS_POLICY_PATH=
# XHS_AGENT_RULES_PATH=agent.md

# 千帆浏览器 Worker
# XHS_DECISION_URL=http://127.0.0.1:18081
# XHS_CDP_PORT=19222
# XHS_QIANFAN_PROFILE=C:\Users\You\.xhs-qianfan-profile

# 抖店飞鸽网页 Worker（使用独立 Chrome 配对端口）
# DOUYIN_DECISION_URL=http://127.0.0.1:18081
# DOUYIN_CDP_URL=http://127.0.0.1:19223
# DOUYIN_STORE_ID=STORE-001
# DOUYIN_TENANT_ID=demo
# DOUYIN_AUTO_OPEN_UNREAD=1
# 页面版本变化时可按 docs/deployment-douyin.md 覆盖 DOM 选择器
